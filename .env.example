# ========================================================
# KORRECTPAY WEB APP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your credentials
# ========================================================

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GongozAPI (VTU, Data, Electricity, Cable TV)
GONGOZ_API_KEY=your-gongoz-api-key
GONGOZ_API_BASE_URL=https://www.gongozconcept.com/api

# MomoPanel API (Social Media Boost Campaigns)
MOMO_API_KEY=your-momo-api-key
MOMO_API_BASE_URL=https://momopanel.com/api/v2

# GrizzlySMS API (Virtual SMS Numbers Server 1)
GRIZZLY_API_KEY=your-grizzly-api-key
GRIZZLY_API_BASE_URL=https://api.grizzlysms.com/stubs/handler_api.php

# SMSPool API (Virtual SMS Numbers Server 2)
SMSPOOL_API_KEY=your-smspool-api-key
SMSPOOL_BASE_URL=https://api.smspool.net

# Fadded Socials Reseller API
FADDED_API_KEY=your-fadded-api-key
FADDED_API_BASE_URL=https://fadded.net/api/v1/reseller

# Korapay (Virtual Bank Accounts & Automated Funding Webhook)
KORAPAY_PUBLIC_KEY=pk_live_xxxxxx
KORAPAY_SECRET_KEY=sk_live_xxxxxx
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Cron Jobs Security Secret (For Cron-Job.org automated sync & refunds)
CRON_SECRET=korrectpay_cron_secret_2026

# Web App Public URL
NEXT_PUBLIC_APP_URL=https://korrectpay.com

# SMTP Transactional Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=support@korrectpay.com
SMTP_FROM_NAME=KorrectPay
